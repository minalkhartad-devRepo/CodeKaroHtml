<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add User</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="mt-32 w-[1000px] mx-auto text-center rounded-lg  p-8 bg-gray-200 shadow-lg shadow-gray-100/50 ">
        <div class="flex justify-between">
            <h1 class="text-2xl text-cente font-black font-normal ">User Management</h1>
            <a href="/">Back</a>
        </div>
        <div class="m-8">
            <form action="/submitUserData" method="post" class="text-left">

                <div class="flex gap-3 items-center">
                    <label for="fname" class="flex  w-full max-w-40 whitespace-nowrap font-black font-light">First Name : </label>
                    <input name="fname" type="text" required class="border rounded-lg p-3 mt-3 text-black w-full max-w-90 focus:outline-none">
                </div>

                <div class="flex gap-3 items-center">
                    <label for="lname" class="flex  w-full max-w-40 whitespace-nowrap font-black font-light">Last Name : </label>
                    <input name="lname" type="text" required class="border rounded-lg p-3 mt-3 text-black w-full max-w-90 focus:outline-none">
                </div>

                <div class="flex gap-3 items-center">
                    <label for="email" class="flex  w-full max-w-40 whitespace-nowrap font-black font-light">Email : </label>
                    <input name="email" type="email" required class="border rounded-lg p-3 mt-3 text-black w-full max-w-90 focus:outline-none">
                </div>

                <div class="flex gap-3 items-center">
                    <label for="phnno" class="flex  w-full max-w-40 whitespace-nowrap font-black font-light">Phone Number : </label>
                    <input name="phnno" type="number" required class="border rounded-lg p-3 mt-3 text-black w-full max-w-90 focus:outline-none">
                </div>

                <div class="flex gap-3 items-center">
                    <label for="profUrl" class="flex  w-full max-w-40 whitespace-nowrap whitespace-nowrap font-black font-light">Profile Url : </label>
                    <input name="profUrl" type="text" required class="border rounded-lg p-3 mt-3 text-black w-full max-w-90 focus:outline-none">
                </div>


                <button class="bg-gray-500 text-white px-3 py-2 mt-4 rounded-lg font-light"  type="submit">Submit Data</button>
            </form>            
        </div>
        
    </div> 

</body>
</html>