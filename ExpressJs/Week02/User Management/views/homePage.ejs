<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


</head>
<body>
    <div class="mt-32 w-[1000px] mx-auto text-center rounded-lg  p-8 bg-gray-200 shadow-lg shadow-gray-100/50 ">
        <div class="flex justify-between">
            <h1 class="text-2xl text-center font-black font-normal ">User Management</h1>
            <a href="/adduser">Add user</a>
        </div>
        <div class="m-8">
            <table class=" text-center w-full justify-between table-auto p-8 border-collapse border border-gray-400 ...">
                    
                <thead>
                    <tr class="m-2">
                        <th class=" p-3 border border-current">Logo</th>
                        <th class=" p-3 border border-current">First Name</th>
                        <th class=" p-3 border border-current">Last Name</th>
                        <th class=" p-3 border border-current">Email</th>
                        <th class=" p-3 border border-current">Phone No.</th>
                        <th class=" p-3 border border-current">Action</th>
                    </tr>
                </thead>
                
                <tbody>
                    <% if(usersCount == 0 ) { %>
                        <tr class="m-2">
                            <td class="p-3 border border-current" colspan="6"> No User Data Available</td>
                        </tr>
                    <% }else { %>
                        <% for(let i=0; i < users.length; i++){%>
                            <tr class="m-2">
                                <td class="p-3 border border-current">                                    
                                    <img src="<%= users[i].profUrl %>" alt="" class="h-10 w-10 rounded-full object-cover">
                                </td>
                                <td class="p-3 border border-current"><%= users[i].fname %></td>
                                <td class="p-3 border border-current"><%= users[i].lname %></td>
                                <td class="p-3 border border-current"><%= users[i].email %></td>
                                <td class="p-3 border border-current"><%= users[i].phnno %></td>
                                <td class="p-3 border border-current ">
                                    <span class="flex gap-2 ">
                                        <form action="/edit" method="post" class="inline">
                                            <input type="hidden" name="personId" value="<%= i %>">
                                            <button type="submit"></button>
                                        </form>
                                        <form action="/delete" method="post" class="inline">
                                            <input type="hidden" name="personId" value="<%= i %>">
                                            <button type="submit"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </span>
                                </td>
                            </tr> 
                        <% }%>
                    <% } %>         
                </tbody>

                
            </table>            
        </div>        
    </div> 

</body>
</html>