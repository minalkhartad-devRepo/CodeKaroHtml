<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo App</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<body>
    <div class="border mt-32 w-[1000px] mx-auto text-center rounded-lg 
        ring-2 ring-blue-500">

        <div class="m-4 p-4">
            <h1 class="text-lg text-blue-700">Welcome To Todo App</h1>
        </div>        

        <div class="m-4 p-4 ">
            <form action="/addTodo" method="post">
                <div class="flex justify-center gap-4">
                    <div>
                    <input class="w-80 py-1 rounded-lg ring-2 ring-blue-500" type="text" name="title" placeholder="Enter Todo Title">
                    </div>
                    <div>
                        <button class = " w-20 py-1 border rounded-lg bg-blue-500 ring-2 ring-blue-500"  type="submit">Submit</button>
                    </div>
                </div>                
            </form>
        </div>

        <div>
            <div class="mt-4">
                <h3 class="text-lg text-blue-700">Todo List</h3>
            </div> 

            <div class="mb-4 p-4 text-center flex items-stretch justify-center">
                <Table class="border-collapse  w-100 mx-auto border border-gray-400 ">
                    <thead>
                        <tr class="bg-blue-200">
                            <th class="border border-gray-300 px-4 py-3 ">Task</th>
                            <th class="border border-gray-300 px-4 py-3">Status</th>
                            <th class="border border-gray-300 px-4 py-3">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                         <%todoData.forEach(todo=>{%>
                        <tr>
                            <td class="border border-gray-300 p-2 text-center"><%=todo.title%></td>
                            <td class="border border-gray-300 p-2 text-center"><%=todo.isCompleted ? 'Completed' : 'Not Completed'%></td>
                            <td class="border border-gray-300 p-2 text-center">
                                <a href="/deleteTodo/<%=todo.id%>"><i class="bi bi-trash3"></i></a>
                                <a href="/update/<%=todo.id%>"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                        <%})%>
                    </tbody>
                       
                </Table>
            </div>  

        </div> 
      
    </div>
    
</body>
</html>